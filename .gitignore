# --------------------------------------------------------------------
# [Python Core]
# --------------------------------------------------------------------
# 컴파일된 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class

# C 확장 모듈
*.so

# --------------------------------------------------------------------
# [Virtual Environments & Distribution]
# --------------------------------------------------------------------
# 가상환경 (가장 중요)
.venv
.venv/
venv/
venv_wsl/
env/
ENV/

# 빌드 및 배포 아티팩트
build/
dist/
*.egg-info/
.eggs/
configs

# 패키지 설치 에러 로그
pip-log.txt
pip-delete-this-directory.txt

# --------------------------------------------------------------------
# [IDE & Tools]
# --------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# --------------------------------------------------------------------
# [Environment & Security - 절대 유출 금지]
# --------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
config.py  # 설정 파일이 별도로 있다면 제외 고려

# --------------------------------------------------------------------
# [Project Specific - AgentCLI & Supabase]
# --------------------------------------------------------------------
# 에이전트 로컬 메모리/스킬 데이터 (이전 설정 유지)
.agent/
.skills/
AGENTS.md
# Supabase 로컬 설정 및 임시 파일
.supabase/
supabase/.temp/
supabase/functions/.env

# AI 모델 가중치 파일 (대용량 파일 실수 방지)
*.pt
*.pth
*.onnx
*.safetensors
*.bin
.claude
# --------------------------------------------------------------------
# [OS & Misc]
# --------------------------------------------------------------------
.DS_Store
Thumbs.db