{
  "config_version": 2,
  "repo": "D:/000.Work/001.Private/000.API/agent_cli",
  "execution_backend": "codex",
  "roles": "PM,Dev,QA",
  "profile": "personal",
  "autopilot": true,
  "continuous": true,
  "iterations": 3,
  "max_turns_per_task": 20,
  "resume_latest": false,
  "run_dir": "",
  "worktree_isolation": true,
  "isolate_task": false,
  "gitops": {
    "worktree_merge_mode": "manual",
    "untracked_exclude_globs": [
      ".doc/**",
      ".doc",
      ".AgentCLI/**",
      ".AgentCLI",
      ".agent_runs/**",
      ".agent_runs",
      ".test-scratch/**",
      ".tmp-*",
      "*.log"
    ]
  },
  "goals_enabled": true,
  "goals_auto_generate": true,
  "goals_auto_check": true,
  "goals_auto_refresh": false,
  "goals_completion_level": "all",
  "pm_include_working_tree": true,
  "pm_refresh_backlog": false,
  "docs_read_mode": "digest",
  "docs_dir": ".doc/Docs",
  "docs_digest_file": ".doc/DOCS_DIGEST.md",
  "prompts_dir": "",
  "no_build": false,
  "require_build": true,
  "build_cmd": [
    ".venv/Scripts/python.exe",
    "-B",
    "-m",
    "py_compile",
    "agent_runner/web.py",
    "agent_runner/process_guard.py",
    "tests/web_console_playwright_smoke.py"
  ],
  "run_tests": true,
  "test_cmd": [
    "powershell.exe",
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-Command",
    "& .\\.venv\\Scripts\\python.exe -B -m unittest discover -s tests -p 'test_web_console*.py'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & .\\.venv\\Scripts\\python.exe -B -m unittest discover -s tests -p 'test_worktree*.py'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & .\\.venv\\Scripts\\python.exe -B .\\tests\\web_console_playwright_smoke.py"
  ],
  "build_timeout_seconds": 1200,
  "test_timeout_seconds": 3600,
  "pm_timeout_seconds": 1200,
  "dev_timeout_seconds": 3600,
  "pm_bootstrap_max_turns": 32,
  "pm_incremental_max_turns": 20,
  "pm_structured_retries": 2,
  "pm_max_turns_continuations": 1,
  "dev_max_turns_continuations": 2,
  "qa_always": true,
  "qa_to_backlog": false,
  "max_qa_followups": 5,
  "allow_no_diff": false,
  "dangerous_git_rollback": false,
  "failover_enabled": false,
  "failover_backends": [
    "codex"
  ],
  "failover_on": [],
  "failover_max_switches": 0,
  "pm_model": "gpt-5.5",
  "dev_model": "gpt-5.4",
  "qa_model": "gpt-5.5",
  "reporter_model": "gpt-5.4-mini",
  "dev_auto_escalate": true,
  "dev_max_escalations": 2,
  "dev_model_tier1": "gpt-5.5",
  "dev_model_tier2": "gpt-5.5",
  "dev_escalate_on": [
    "no_diff",
    "build_failed",
    "test_failed",
    "no_commits"
  ],
  "mcp_mode": "codex",
  "codex_package": "@openai/codex@latest",
  "claudecode_model": "",
  "claudecode_pm_model": "",
  "claudecode_dev_model": "",
  "claudecode_qa_model": "",
  "claudecode_reporter_model": "",
  "claudecode_dev_model_tier1": "",
  "claudecode_dev_model_tier2": "",
  "claudecode_mcp_tools_enabled": false,
  "claudecode_hooks_enabled": false,
  "claudecode_subagents_enabled": false,
  "plugins_enabled": false,
  "skills": {
    "enabled": false,
    "roots": [
      "C:/Users/USER/.codex/skills",
      "C:/Users/USER/.agents/skills",
      "C:/Users/USER/.claude/skills"
    ],
    "inline_mode": "qa",
    "pm_summary_max_items": 120,
    "pm_summary_max_chars": 8000,
    "qa_max_total_chars": 8000
  },
  "policy": {
    "enabled": null,
    "fail_severity": "high",
    "rules": [],
    "ignore_paths": [],
    "allow_patterns": []
  },
  "security": {
    "enabled": false,
    "fail_severity": "high",
    "rules_path": ""
  },
  "scan_scope": "quick",
  "policy_scan_scope": "",
  "security_scan_scope": "",
  "scan_ignore_globs": [
    ".doc/**",
    ".doc",
    ".AgentCLI/**",
    ".AgentCLI",
    ".agent_runs/**",
    ".agent_runs",
    ".test-scratch/**",
    ".tmp-*",
    "worktree/**",
    "**/*.log"
  ],
  "task_history_enabled": true,
  "task_history_max_items": 25,
  "telegram": {
    "enabled": false,
    "runner_mode": "thread",
    "notify_events": [
      "run_start",
      "run_stop",
      "task_done",
      "task_failed",
      "quota",
      "error",
      "stalled",
      "project_complete"
    ],
    "send_cycle_summary": true,
    "notify_poll_interval_seconds": 8,
    "stalled_seconds": 600
  }
}
